# Skopiuj do .env i zmień w razie potrzeby (plik .env nie trafia do repo)
HTTP_TIMEOUT_S=20
SOIL_SAMPLE_POINTS=9
HISTORY_YEARS=10
# przykłady demo: rozgrzewka cache w tle przy starcie (true/false) i co ile godzin ją powtarzać
DEMO_WARMUP=true
DEMO_WARMUP_INTERVAL_H=6
# adres aplikacji w kodzie QR raportu PDF (np. adres publiczny przy prezentacji)
PUBLIC_URL=http://localhost:5173
# trwały cache wszystkich źródeł (w docker compose ustawione na /data/cache.sqlite w wolumenie)
# CACHE_DB=/data/cache.sqlite
# tryb demo offline: tylko cache, żadnych zapytań zewnętrznych (przed tym: scripts/warm_demo.py na dobrej sieci)
DEMO_OFFLINE=false
